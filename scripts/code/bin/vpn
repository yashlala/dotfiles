#!/bin/sh

# start chromium as non-root. Then, our openconnect-initiated
# chromium tab will open in the existing window, which didn't run as root :)

dex ~/.local/share/applications/chromium.desktop
sleep 2s

exec sudo -E /usr/bin/openconnect \
  --useragent=AnyConnect \
  --external-browser="$HOME/.local/scripts/chromium-no-sandbox" \
  access.yale.edu
