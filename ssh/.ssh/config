# Host-specific settings, such as aliases and custom ssh-key files. 
Include hostconf

# General host-agnostic settings. 
# These should be _after_ `hostconf` include, to keep these options from overriding the host-specific settings.
Host * 
	ServerAliveInterval 64
	AddKeysToAgent yes
	IdentitiesOnly yes

	# Reuse the SSH connection between sessions
	ControlMaster auto
	ControlPath ~/.ssh/sock-%C
	# Persist connection after session exit (helps w/ SCP & repeated connections)
	ControlPersist 5m
