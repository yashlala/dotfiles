#!/bin/sh

exec /usr/bin/chromium --no-default-browser-check --no-sandbox "$@"

# TODO figure out how to use a new profile

# This script needs to be run as sudo
if [ "$EUID" -ne 0 ]; then
  echo "This script must be run as root." >/dev/stderr
  exit 1
fi

unset XDG_CACHE_HOME
unset XDG_CONFIG_HOME
unset XDG_DATA_HOME
export HOME=/root
export DISPLAY=":0"
export WAYLAND_DISPLAY="wayland-1"

cd /root
exec /usr/bin/chromium \
  --profile-directory='VPN' \
  --user-data-dir=/root/chromium-no-sandbox \
  --no-default-browser-check \
  --no-sandbox \
  "$@"
